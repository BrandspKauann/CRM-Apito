# Alternativa de conexão direta. Não publique o valor real nem use usuário administrador.
# Para acesso remoto direto, valide o certificado TLS do PostgreSQL.
DATABASE_URL=postgresql://usuario:senha@host/brain_apito?sslmode=verify-full

# A configuração por SSH, quando definida, prevalece sobre DATABASE_URL.
# Cadastre o JSON completo como segredo do ambiente de execução, sem colar uma chave neste arquivo.
# O exemplo abaixo contém apenas marcadores; substitua-os em um arquivo privado ou no provedor.
# CRM_VPS_CONNECTION={"host":"HOST_DA_VPS","sshUser":"USUARIO_DEDICADO_DO_TUNEL_RESTRITO","privateKey":"CHAVE_PRIVADA_PROTEGIDA","hostFingerprint":"FINGERPRINT_SHA256_HEXADECIMAL_VERIFICADO","dbHost":"HOST_INTERNO_DO_POSTGRESQL","database":"brain_apito","user":"brain_crm","password":"SEGREDO_DO_BANCO","searchPath":"crm,brain,public"}

# Aplique a migração antes de conectar o CRM aos novos schemas.
# Este é o único valor de search_path aceito pelo CRM; o campo searchPath do JSON tem prioridade.
BRAIN_APITO_SEARCH_PATH=crm,brain,public

CRM_ADMIN_USER=kauann
CRM_ADMIN_PASSWORD=defina-uma-senha-forte
# Gere 32 bytes aleatórios para cada segredo: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRM_SESSION_SECRET=64-caracteres-hexadecimais
CRM_ENCRYPTION_KEY=64-caracteres-hexadecimais
